   "source": [
    "def subtract (a,b):\n",
    "    c = a - b\n",
    "    return c\n",
    "\n",
    "\n",
    "a = subtract(2, 1)\n",
    "print(a)\n",
    "print(subtract(25, 5))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f5abfb53",
   "metadata": {},
   "outputs": [],
   "source": [
    "def distance_from_zero(x):\n",
    "    if x >= 0:\n",
    "        return subtract(x, 0)\n",
    "    else:\n",
    "        return subtract(0, x)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "af884528",
   "metadata": {},
   "outputs": [],
   "source": [
    "print(distance_from_zero(-5))  # Output: 5"
   ]
